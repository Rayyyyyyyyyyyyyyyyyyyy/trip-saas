{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trip-runtime.local/schemas/canonical-trip.v1.schema.json",
  "title": "CanonicalTrip v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "start_date",
    "end_date",
    "timezone",
    "geography",
    "days",
    "entities",
    "relationships",
    "supporting_items"
  ],
  "properties": {
    "schema_version": { "const": "canonical-trip.v1" },
    "id": { "$ref": "#/$defs/stableId" },
    "title": { "$ref": "#/$defs/nullableText" },
    "start_date": { "$ref": "#/$defs/nullableDate" },
    "end_date": { "$ref": "#/$defs/nullableDate" },
    "timezone": { "$ref": "#/$defs/nullableText" },
    "geography": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "days": {
      "type": "array",
      "items": { "$ref": "#/$defs/day" }
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "supporting_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/supportingItem" }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nullableText": { "type": ["string", "null"] },
    "nullableDate": {
      "anyOf": [
        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        { "type": "null" }
      ]
    },
    "nullableTime": {
      "anyOf": [
        { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
        { "type": "null" }
      ]
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "date",
        "source_order",
        "label",
        "title",
        "subtitle",
        "leave_by"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "date": { "$ref": "#/$defs/nullableDate" },
        "source_order": { "type": "integer", "minimum": 0 },
        "label": { "$ref": "#/$defs/nullableText" },
        "title": { "$ref": "#/$defs/nullableText" },
        "subtitle": { "$ref": "#/$defs/nullableText" },
        "leave_by": { "$ref": "#/$defs/nullableTime" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "url"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "kind": { "enum": ["map", "restaurant", "reference"] },
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "address", "url", "unresolved"],
      "properties": {
        "name": { "$ref": "#/$defs/nullableText" },
        "address": { "$ref": "#/$defs/nullableText" },
        "url": {
          "anyOf": [
            { "type": "string", "pattern": "^https://" },
            { "type": "null" }
          ]
        },
        "unresolved": { "type": "boolean" }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "start",
        "end",
        "daypart",
        "raw_text",
        "crosses_midnight"
      ],
      "properties": {
        "kind": {
          "enum": [
            "exact",
            "approximate",
            "range",
            "daypart",
            "none",
            "open_ended",
            "all_day"
          ]
        },
        "start": { "$ref": "#/$defs/nullableTime" },
        "end": { "$ref": "#/$defs/nullableTime" },
        "daypart": {
          "type": ["string", "null"],
          "enum": ["morning", "afternoon", "evening", "night", "unknown", null]
        },
        "raw_text": { "$ref": "#/$defs/nullableText" },
        "crosses_midnight": { "type": "boolean" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optional", "tentative", "flexible", "unresolved"],
      "properties": {
        "optional": { "type": "boolean" },
        "tentative": { "type": "boolean" },
        "flexible": { "type": "boolean" },
        "unresolved": { "type": "boolean" }
      }
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reference", "detail", "todo_id"],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "not_required",
            "action_needed",
            "pending",
            "confirmed",
            "cancelled"
          ]
        },
        "reference": { "$ref": "#/$defs/nullableText" },
        "detail": { "$ref": "#/$defs/nullableText" },
        "todo_id": {
          "anyOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }]
        }
      }
    },
    "ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reference", "detail", "todo_id"],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "not_required",
            "action_needed",
            "pending",
            "ready",
            "unavailable"
          ]
        },
        "reference": { "$ref": "#/$defs/nullableText" },
        "detail": { "$ref": "#/$defs/nullableText" },
        "todo_id": {
          "anyOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }]
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "detail", "todo_id"],
      "properties": {
        "kind": {
          "enum": ["reservation", "ticket", "document", "payment", "other"]
        },
        "status": {
          "enum": [
            "unknown",
            "not_required",
            "action_needed",
            "pending",
            "ready",
            "blocked"
          ]
        },
        "detail": { "$ref": "#/$defs/nullableText" },
        "todo_id": {
          "anyOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "overridden_fields"],
      "properties": {
        "origin": { "enum": ["source", "user"] },
        "overridden_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "day_id",
        "semantic_type",
        "title",
        "place",
        "time",
        "state",
        "reservation",
        "ticket",
        "readiness",
        "notes",
        "actions",
        "provenance"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "day_id": {
          "anyOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }]
        },
        "semantic_type": {
          "enum": [
            "flight",
            "accommodation",
            "transit",
            "activity",
            "restaurant",
            "free_time",
            "reservation",
            "ticket",
            "preparation",
            "note",
            "unknown"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "place": { "$ref": "#/$defs/place" },
        "time": { "$ref": "#/$defs/time" },
        "state": { "$ref": "#/$defs/state" },
        "reservation": {
          "anyOf": [{ "$ref": "#/$defs/reservation" }, { "type": "null" }]
        },
        "ticket": {
          "anyOf": [{ "$ref": "#/$defs/ticket" }, { "type": "null" }]
        },
        "readiness": {
          "anyOf": [{ "$ref": "#/$defs/readiness" }, { "type": "null" }]
        },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "member_entity_ids",
        "parent_entity_id",
        "child_entity_ids",
        "condition"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "type": {
          "enum": [
            "sequence",
            "alternative",
            "conditional",
            "fallback",
            "parent_child"
          ]
        },
        "member_entity_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "parent_entity_id": {
          "anyOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }]
        },
        "child_entity_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "condition": { "$ref": "#/$defs/nullableText" }
      }
    },
    "supportingItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "text", "url", "unresolved"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "kind": {
          "enum": ["reference", "instruction", "timetable", "asset", "note", "other"]
        },
        "text": { "$ref": "#/$defs/nullableText" },
        "url": {
          "anyOf": [
            { "type": "string", "pattern": "^https://" },
            { "type": "null" }
          ]
        },
        "unresolved": { "type": "boolean" }
      }
    }
  }
}
